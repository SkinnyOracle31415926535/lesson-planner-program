      "mustUse": [
        "normalized zone boundaries",
        "relative positions",
        "scale",
        "orientation",
        "overlap geometry",
        "landmark placement",
        "rendering order"
      ],
      "mustNotInferFromAnnotatedPdfs": true,
      "reason": "The owner reported that the exported PDFs visually displaced or distorted some equipment and floor objects."
    },
    "consumerRequirements": [
      "Do not add coordinates, bounds, rotation, z-index, or physical-layout assumptions to this registry.",
      "Do not make an unconfirmed duplicate label collapse into one physical destination.",
      "Do not use a schedule alias as an automatic instruction to add a zone to a phase.",
      "A composite group renders as one combined board containing its member-zone overlays, never as a new third physical station."
    ]
  },
  "categoryDefinitions": {
    "selectable_station": "A physical apparatus or station that can receive lesson content.",
